{
  "name": "achievement-diary",
  "version": "1.0.0",
  "private": true,
  "description": "Личный «Дневник достижений»: PWA + собственный сервер",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "vite build",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
